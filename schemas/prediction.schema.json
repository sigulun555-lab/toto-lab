{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sigulun555-lab/toto-lab/schemas/prediction.schema.json",
  "title": "Toto prediction record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predictionId",
    "round",
    "matchNumber",
    "homeTeam",
    "awayTeam",
    "probabilities",
    "predictionConfirmedAt",
    "deadlineAt",
    "modelName",
    "modelVersion",
    "revisionOf"
  ],
  "properties": {
    "predictionId": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "matchNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 13
    },
    "homeTeam": {
      "type": "string",
      "minLength": 1
    },
    "awayTeam": {
      "type": "string",
      "minLength": 1
    },
    "probabilities": {
      "type": "object",
      "required": [
        "1",
        "0",
        "2"
      ],
      "additionalProperties": false,
      "properties": {
        "0": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "predictionConfirmedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deadlineAt": {
      "type": "string",
      "format": "date-time"
    },
    "modelName": {
      "type": "string",
      "enum": [
        "ChatGPT",
        "Claude"
      ]
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1
    },
    "revisionOf": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceRetrievedAt": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "corrections": {
      "type": "object",
      "description": "本番予測モデルの補正値のスナップショット（任意）。この比較基盤自体は補正ロジックを変更しない。未使用の補正は null を入れる。",
      "additionalProperties": false,
      "properties": {
        "dixonColes": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "drawBoostVariant": {
          "type": [
            "string",
            "null"
          ]
        },
        "shrinkageSampleTrust": {
          "type": [
            "number",
            "null"
          ]
        },
        "marketBlendWeight": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "dataSource": {
      "type": "string",
      "description": "この予測値をどこから得たか（例: 本番アプリのpredictScore()実際の出力、過去スナップショットの再計算など）を記録する任意フィールド。"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url",
              "retrievedAt"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "retrievedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "homeTeamStatus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "standing": {
              "type": [
                "integer",
                "null"
              ]
            },
            "goalDiff": {
              "type": [
                "integer",
                "null"
              ]
            },
            "recentFormPeriod": {
              "type": "string"
            },
            "recentFormCompetitions": {
              "type": "string"
            },
            "homeAwaySplit": {
              "type": "string",
              "enum": [
                "home",
                "away"
              ]
            },
            "absences": {
              "type": "string"
            }
          }
        },
        "awayTeamStatus": {
          "$ref": "#/properties/evidence/properties/homeTeamStatus"
        },
        "probabilityRationale": {
          "type": "string"
        },
        "quantitativeContribution": {
          "type": "string",
          "enum": [
            "quantified",
            "not_quantified"
          ]
        },
        "confidenceLevel": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "unconfirmed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modelOrigin": {
          "type": "string",
          "enum": [
            "production_model_output",
            "independent_estimate"
          ]
        }
      }
    }
  }
}
